app AdminDemo {
  "Proves ui.admin: its design, a StatCard and an EmptyState."
}

import ui.admin

state {
  count: Int = 3
}

screen {
  section stat as StatCard {
    text statLabel = "Open"
    text statValue = @count
  }
  button clear "Clear"
  section nothing as EmptyState {
    visible when @count is 0
    text nothingTitle = "Nothing open"
    text nothingHint = "New items show up here."
  }
}

on click clear {
  - set @count to 0
}

example "a stat and the empty state" {
  see statValue = "3"
  see nothing is hidden
  click clear
  see statValue = "0"
  see nothingTitle = "Nothing open"
  see nothingHint = "New items show up here."
}
