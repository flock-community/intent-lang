app Helpdesk {
  "A support desk for a small team: see what needs attention, triage tickets and answer customers."
}

import ui.admin
import std.list
import std.feedback
import support.tickets

choice Page: Inbox | Reports | Settings
choice StatusFilter: AllTickets "All" | OnlyOpen "Open" | OnlyPending "Pending" | OnlySolved "Solved"
choice Sort: Newest "Newest first" | Oldest "Oldest first" | ByPriority "Priority"

record Bar {
  label: Text
  count: Int
  share: Int
}

state {
  page: Page = Inbox
  tickets: List Ticket = table {
    id | subject                        | customer        | priority | status  | assignee
    1  | "Cannot log in after reset"    | "Mara Jansen"   | Urgent   | Open    | "Sam"
    2  | "Invoice shows wrong VAT"      | "Piet de Vries" | High     | Open    | "Alex"
    3  | "Feature request: dark mode"   | "Lena Smit"     | Low      | Pending | "Sam"
    4  | "App crashes on upload"        | "Joost Bakker"  | Urgent   | Pending | "Alex"
    5  | "Change billing address"       | "Eva Visser"    | Normal   | Solved  | "Sam"
    6  | "Export to CSV is empty"       | "Tom Mulder"    | High     | Open    | ""
    7  | "Password rules unclear"       | "Iris de Boer"  | Normal   | Open    | "Alex"
    8  | "Refund for double charge"     | "Noah Peters"   | Urgent   | Open    | ""
  }
  comments: List Comment = table {
    ticket | author         | body
    1      | "Mara Jansen"  | "I reset my password but the login page keeps rejecting it."
    1      | "Sam"          | "Thanks Mara, looking into it now."
    4      | "Joost Bakker" | "It happens with every file larger than 10 MB."
  }
  search: Text = ""
  statusFilter: StatusFilter = AllTickets
  sort: Sort = Newest
  selected: Int = 0          # id of the ticket open in the drawer; 0 for none
  reply: Text = ""
  showNew: Bool = false
  newSubject: Text = ""
  newCustomer: Text = ""
  newPriority: Priority = Normal
  notifyCustomer: Bool = true
  compactRows: Bool = false
  signature: Text = "The Support Team"
}

derive {
  matching = the @tickets whose @subject or @customer contains @search (trimmed, ignoring case), and whose @status fits @statusFilter (@AllTickets fits every @status)
  sorted = @matching in the order of @sort: @Newest is highest @id first; @Oldest is lowest @id first; @ByPriority is @Urgent, @High, @Normal, @Low, and within one @priority highest @id first
  urgentOpen = the number of @Urgent @tickets that are not @Solved
  current = the ticket whose @id is @selected
  thread = the @comments whose @ticket is @selected, in their order
  byPriority = one @Bar per @priority, in the order @Urgent, @High, @Normal, @Low: @label is the @priority's name, @count is the number of @tickets with that @priority that are not @Solved, and @share is @count × 100 divided by the largest @count of the four, rounded down (0 when all counts are 0)
}

screen {
  section sidebar as sidebar {
    heading "Helpdesk" as title
    select page as nav
    section account as footer {
      text userInitials = "ST" as avatar
      text userName = "Sam Taylor" as caption
    }
  }
  section content as main {
    section header as header {
      text pageTitle = the text users see for @page: "Inbox", "Reports" or "Settings" as title
      field search "Search tickets" as search {
        visible when @page is @Inbox
      }
      button newTicket "New ticket" as primary
    }
    text urgentAlert = "{urgentOpen} urgent tickets need attention" as alert {
      visible when @page is @Inbox and @urgentOpen is at least 3
    }
    section stats as grid {
      visible when @page is @Inbox
      look "four cards in one row on wide screens, two per row on small screens"
      section openStat as StatCard {
        text openLabel = "Open"
        text openValue = the number of @Open @tickets
      }
      section pendingStat as StatCard {
        text pendingLabel = "Pending"
        text pendingValue = the number of @Pending @tickets
      }
      section solvedStat as StatCard {
        text solvedLabel = "Solved"
        text solvedValue = the number of @Solved @tickets
      }
      section unassignedStat as StatCard {
        text unassignedLabel = "Unassigned"
        text unassignedValue = the number of @tickets that are not @Solved and have no @assignee
      }
    }
    section inbox as card {
      visible when @page is @Inbox
      section filters as toolbar {
        select statusFilter as chips
        select sort "Sort by" as dropdown
      }
      list shown of Ticket = @pager.visible as table {
        look "columns: ticket, subject, customer, priority, status, assignee, and the action on the right; rows are tighter when compactRows is on"
        text ticketId = "#{id}"
        text subject
        text customer
        text priority as PriorityBadge
        text status as StatusBadge
        text assignee = the @assignee, or "Unassigned" when it is empty
        button open "View" as link
      }
      section empty as EmptyState {
        visible when shown is empty
        text emptyTitle = "No tickets found"
        text emptyHint = "Try another search or filter."
      }
      use pager = Pager {
        items = sorted
        size = 5
      }
    }
    section reports as card {
      visible when @page is @Reports
      heading "Resolution"
      progress solvedShare "Solved" = the @share of @tickets that are @Solved, in percent, rounded down
      text solvedLine = "{number of @Solved @tickets} of {number of @tickets} tickets solved"
      heading "Open work by priority"
      list byPriority of Bar as bars {
        look "a horizontal bar chart: label on the left, a bar whose length is the share, the count on the right"
        text label
        progress share
        text count
      }
    }
    section settings as form {
      visible when @page is @Settings
      checkbox compactRows "Compact table rows" as toggle
      field signature "Reply signature" as textarea
      text preview = "Preview: {signature}" as caption
    }
  }
  section detail as drawer {
    visible when @selected is not 0
    text detailSubject = the @subject of @current as title
    text detailMeta = "#{@id of @current} · {@customer of @current}" as caption
    text detailPriority = the @priority of @current as PriorityBadge
    text detailStatus = the @status of @current as StatusBadge
    list thread of Comment as timeline {
      text author
      text body
    }
    field reply "Reply" as textarea
    button send "Send reply" as primary {
      enabled when @reply is not blank
    }
    button solve "Mark as solved" as secondary {
      enabled when @current is not @Solved
    }
    button close "Close" as ghost
  }
  section newDialog "New ticket" as dialog {
    visible when @showNew
    field newSubject "Subject"
    field newCustomer "Customer"
    select newPriority "Priority" as segmented
    checkbox notifyCustomer "Email the customer a confirmation" as toggle
    button create "Create ticket" as primary {
      enabled when @newSubject is not blank and @newCustomer is not blank
    }
    button cancel "Cancel" as secondary
  }
  use toast = Toast
}

on type search {
  - set @pager.page to 1
}

on choose statusFilter {
  - set @pager.page to 1
}

on choose sort {
  - set @pager.page to 1
}

on choose page {
  - set @selected to 0
}

on click open {
  - set @selected to the @id of that ticket
  - clear @reply
}

on click close {
  - set @selected to 0
}

on click send {
  - add a @Comment to the end of @comments with @ticket = @selected, @author = "Sam" and @body = @reply trimmed
  if @current is @Open {
    - set its @status to @Pending
  }
  - clear @reply
  - set @toast.message to "Reply sent"
}

on click solve {
  - set the @status of @current to @Solved
  - set @toast.message to "Ticket #<id of current> solved"
}

on click newTicket {
  - set @showNew to true
  - clear @newSubject and @newCustomer; set @newPriority to @Normal and @notifyCustomer to true
}

on click create {
  - add a @Ticket to the end of @tickets with @id = the highest @id + 1, @subject = @newSubject trimmed, @customer = @newCustomer trimmed, @priority = @newPriority, @status @Open and @assignee ""
  - set @showNew to false
  - set @toast.message to "Ticket #<new id> created", followed by " · customer notified" when @notifyCustomer
  - set @page to @Inbox, @search to "", @statusFilter to @AllTickets, @sort to @Newest and @pager.page to 1
}

on click cancel {
  - set @showNew to false
}

always {
  see shown has at most 5 rows
}

example "the inbox at a glance" {
  snapshot "inbox"
  see pageTitle = "Inbox"
  see openValue = "5"
  see pendingValue = "2"
  see solvedValue = "1"
  see unassignedValue = "2"
  see urgentAlert = "3 urgent tickets need attention"
  see shown has 5 rows
  see ticketId on row 1 = "#8"
  see subject on row 1 = "Refund for double charge"
  see customer on row 1 = "Noah Peters"
  see assignee on row 1 = "Unassigned"
  see priority on row 1 = "Urgent"
  see status on row 5 = "Pending"
  see pager.pageInfo = "Page 1 of 2"
  see pager.previous is disabled
  see pager.next is enabled
  see detail is hidden
  see newDialog is hidden
  see toast.message is hidden
  see userName = "Sam Taylor"
}

example "paging" {
  click pager.next
  see pager.pageInfo = "Page 2 of 2"
  see shown has 3 rows
  see ticketId on row 1 = "#3"
  see pager.next is disabled
  click pager.previous
  see ticketId on row 1 = "#8"
}

example "search and filters" {
  click pager.next
  type "invoice" into search
  see pager.pageInfo = "Page 1 of 1"
  see shown has 1 row
  see subject on row 1 = "Invoice shows wrong VAT"
  type "zzz" into search
  see shown has 0 rows
  snapshot "nothing found"
  see emptyTitle = "No tickets found"
  see emptyHint = "Try another search or filter."
  type "" into search
  see empty is hidden
  choose OnlyPending in statusFilter
  see shown has 2 rows
  see ticketId on row 1 = "#4"
  see ticketId on row 2 = "#3"
  choose Oldest in sort
  see ticketId on row 1 = "#3"
}

example "sorting by priority" {
  choose ByPriority in sort
  see ticketId on row 1 = "#8"
  see ticketId on row 2 = "#4"
  see ticketId on row 3 = "#1"
  see ticketId on row 4 = "#6"
  see ticketId on row 5 = "#2"
}

example "reading and replying" {
  click open on row with "#4"
  see detailSubject = "App crashes on upload"
  see detailMeta = "#4 · Joost Bakker"
  see detailPriority = "Urgent"
  see thread has 1 row
  see author on row 1 = "Joost Bakker"
  see send is disabled
  snapshot "ticket open"
  type "  We are on it. " into reply
  click send
  see thread has 2 rows
  see body on row 2 = "We are on it."
  see author on row 2 = "Sam"
  see reply = ""
  see toast.message = "Reply sent"
  see detailStatus = "Pending"
  snapshot "reply sent"
  click open on row with "#7"
  see thread has 0 rows
  type "Checking the rules." into reply
  click send
  see detailStatus = "Pending"
  see openValue = "4"
  see pendingValue = "3"
  click close
  see detail is hidden
}

example "solving a ticket" {
  click open on row with "#8"
  click solve
  see detailStatus = "Solved"
  see solve is disabled
  see toast.message = "Ticket #8 solved"
  see solvedValue = "2"
  see urgentAlert is hidden
  click toast.dismiss
  see toast.message is hidden
  see toast.dismiss is hidden
}

example "creating a ticket" {
  click pager.next
  click newTicket
  see newDialog is shown
  see create is disabled
  see notifyCustomer is checked
  type "Two-factor codes arrive late" into newSubject
  type "Sara Kok" into newCustomer
  choose High in newPriority
  snapshot "new ticket dialog"
  click create
  see newDialog is hidden
  see toast.message = "Ticket #9 created · customer notified"
  see pager.pageInfo = "Page 1 of 2"
  see ticketId on row 1 = "#9"
  see priority on row 1 = "High"
  see openValue = "6"
  click newTicket
  see newSubject = ""
  type "Typo on pricing page" into newSubject
  type "Bo Jacobs" into newCustomer
  toggle notifyCustomer
  click create
  see toast.message = "Ticket #10 created"
  click newTicket
  click cancel
  see newDialog is hidden
}

example "reports" {
  choose Reports in page
  see pageTitle = "Reports"
  see search is hidden
  see solvedShare = 12
  see solvedLine = "1 of 8 tickets solved"
  see byPriority has 4 rows
  see label on row 1 of byPriority = "Urgent"
  see count on row 1 = "3"
  see share on row 1 = 100
  see share on row 2 = 66
  see count on row 3 = "1"
  see share on row 4 = 33
  snapshot "reports"
}

example "settings" {
  choose Settings in page
  see pageTitle = "Settings"
  see compactRows is unchecked
  toggle compactRows
  see compactRows is checked
  type "Cheers, Sam" into signature
  see preview = "Preview: Cheers, Sam"
  snapshot "settings"
  choose Inbox in page
  see shown has 5 rows
}
