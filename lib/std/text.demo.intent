app TextDemo {
  "Proves std.text: which texts are a valid Email, and a valid Token."
}
language 1

import std.text

state {
  address: Text = ""
  secret: Text = ""
}

screen {
  field address "Email"
  text verdict = "valid" when @address, trimmed, is a valid @Email, otherwise "invalid"
  field secret "Token"
  text tokenVerdict = "valid" when @secret is a valid @Token, otherwise "invalid"
}

example "valid and invalid addresses" {
  type "ann@example.org" into address
  see verdict = "valid"
  type " ann@example.org " into address
  see verdict = "valid"
  type "ann@example" into address
  see verdict = "invalid"
  type "ann example.org" into address
  see verdict = "invalid"
  type "a b@example.org" into address
  see verdict = "invalid"
}

example "a token is 32 hex digits" {
  type "0123456789abcdef0123456789abcdef" into secret
  see tokenVerdict = "valid"
  type "0123456789ABCDEF0123456789ABCDEF" into secret
  see tokenVerdict = "invalid"
  type "0123456789abcdef" into secret
  see tokenVerdict = "invalid"
}
