layer std.http.apiKey {
  "Every request carries an API key in a header; the caller is whoever the key belongs to."
}

record ApiKey {
  secret: Text
  owner: Text
}

param keys: List ApiKey                            # the keys that may call, and who each belongs to
param keyHeader: Text = "x-api-key"                # the header that carries the key
param public: List Text = []                       # what anyone may call without a key: "/health" (that path), "/bundles/*" (every path under /bundles/), "GET /bundles/*" (only with that method)

provides caller: Text                              # the owner of the key; "" on a public path and for OPTIONS

before every request {
  - secrets are compared in constant time, so the time an answer takes does not reveal how much of a key was right
  if the request's method is OPTIONS {
    - it passes with @caller "": browsers send preflights without an API key
  } else if the request matches an entry of @public {
    - an entry matches when its path part matches the request's path, and, if it starts with a method and a space, that method is the request's method
    - a path part ending in "/*" matches every path that starts with the part before the "*" (so "/bundles/*" matches "/bundles/std.list" and "/bundles/a/b", not "/bundles" or "/bundlesx"); any other path part matches only exactly that path
    - it passes with @caller ""
  } else if the request has no @keyHeader header, or its value is blank {
    answer 401 "Missing API key" with header www-authenticate = "ApiKey"
  } else if no key in @keys has exactly that value as its @secret {
    answer 401 "Unknown API key" with header www-authenticate = "ApiKey"
  } else {
    - it passes with @caller = the @owner of the key with that @secret
  }
}

examples with {
  keys = table {
    secret         | owner
    "k-ann-7f3a"   | "Ann"
    "k-sam-91bc"   | "Sam"
  }
  public = "/health", "/docs/*", "GET /bundles/*"
}

example "a known key: the app knows who calls" {
  request GET "/tickets" with header x-api-key = "k-sam-91bc"
  see status = 200
  see body.reached = true
  see body.caller = "Sam"
}

example "no key" {
  request GET "/tickets"
  see status = 401
  see body.error = "Missing API key"
  see header www-authenticate = "ApiKey"
  see body.reached is absent
}

example "a blank key is no key" {
  request GET "/tickets" with header x-api-key = "   "
  see status = 401
  see body.error = "Missing API key"
}

example "an unknown key, or a known key with different case or spaces" {
  request POST "/tickets" with header x-api-key = "k-ann-0000"
  see status = 401
  see body.error = "Unknown API key"
  request POST "/tickets" with header x-api-key = "K-ANN-7F3A"
  see status = 401
  request POST "/tickets" with header x-api-key = " k-ann-7f3a"
  see status = 401
}

example "public paths and preflights need no key" {
  request GET "/health"
  see status = 200
  see body.caller = ""
  request OPTIONS "/tickets" with header origin = "https://desk.example", header access-control-request-method = "POST"
  see body.reached = true
  see body.caller = ""
}

example "public by prefix, and by method" {
  request GET "/docs/start/intro"
  see status = 200
  see body.caller = ""
  request GET "/docs"
  see status = 401
  request GET "/docsx"
  see status = 401
  request GET "/bundles/std.list"
  see status = 200
  see body.caller = ""
  request POST "/bundles/std.list"
  see status = 401
  see body.error = "Missing API key"
  request POST "/bundles/std.list" with header x-api-key = "k-ann-7f3a"
  see status = 200
  see body.caller = "Ann"
}
