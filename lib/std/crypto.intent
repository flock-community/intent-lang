platform std.crypto {
  "Hashes that need exact, reviewed code: never written per app."
}

function sha256(text: Text): Text          # the SHA-256 of the text's UTF-8 bytes, as 64 lower-case hex digits

example "the standard's test vectors" {
  call sha256 with text = ""
  see sha256 = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
  call sha256 with text = "abc"
  see sha256 = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
  call sha256 with text = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
  see sha256 = "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"
}

example "text is hashed as UTF-8" {
  call sha256 with text = "Café"
  see sha256 = "73473dcc12b763085904a5279d048c4d5b3b008c46f1f32443b99de04aa83a14"
}
