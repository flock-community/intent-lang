app Library {
  "A neighbourhood library desk. The librarian picks a member, sees their loans, and lends or takes back books."
  "A member can borrow a book when a copy is available and they have fewer than 3 books out; otherwise the loan is refused with the reason."
  "There is no real clock: the librarian advances the day number by one. Loans are due 14 days after they were made; overdue loans stand out and are counted at the top."
}

import ui.admin
import std.list
import std.feedback

component DueBadge as badge "Tinted per text: a text that starts with \"Overdue\" in danger, any other text in neutral."
component MemberCard as card "The member's name as a semibold line, the member number and the loan count as muted lines below it."

record Book {
  title: Text               # unique; loans refer to a book by its title
  author: Text
  copies: Int               # copies the library owns
}

record Member {
  number: Int               # the member number, unique; loans refer to a member by it
  name: Text                # unique; the member picker shows names
}

record Loan {
  id: Int
  book: Text                # the title of the lent book
  member: Int               # the number of the member who has it
  lentOn: Int               # the day number the loan was made
  due: Int                  # lentOn + 14
}

state {
  today: Int = 20           # the current day number; only the "Next day" button changes it
  books: List Book = table {
    title                  | author               | copies
    "Beloved"              | "Toni Morrison"      | 2
    "Dune"                 | "Frank Herbert"      | 2
    "Emma"                 | "Jane Austen"        | 1
    "Hamlet"               | "William Shakespeare"| 1
    "Jane Eyre"            | "Charlotte Bronte"   | 2
    "Middlemarch"          | "George Eliot"       | 1
    "Moby-Dick"            | "Herman Melville"    | 1
    "Persuasion"           | "Jane Austen"        | 2
    "Pride and Prejudice"  | "Jane Austen"        | 3
    "The Hobbit"           | "J. R. R. Tolkien"   | 2
    "Ulysses"              | "James Joyce"        | 1
    "Wuthering Heights"    | "Emily Bronte"       | 2
  }
  members: List Member = table {
    number | name
    101    | "Ann Jansen"
    102    | "Ben de Vries"
    103    | "Carla Smit"
    104    | "Daan Bakker"
    105    | "Eva Visser"
  }
  loans: List Loan = table {
    id | book          | member | lentOn | due
    1  | "Dune"        | 101    | 8      | 22
    2  | "Emma"        | 101    | 15     | 29
    3  | "Beloved"     | 102    | 18     | 32
    4  | "Hamlet"      | 102    | 18     | 32
    5  | "Ulysses"     | 102    | 19     | 33
    6  | "Middlemarch" | 103    | 10     | 24
  }
  nextLoanId: Int = 7
  search: Text = ""
  chosen: Text = ""         # the name of the picked member; empty means nobody is picked
}

derive {
  matching = the @books whose @title or @author contains @search trimmed, ignoring upper and lower case, in list order; all @books when @search is blank
  chosenMember = the member whose @name is @chosen, or nothing when @chosen is empty
  chosenLoans = the @loans whose member is the @number of @chosenMember, earliest @due first, ties by lowest @id; empty when nobody is picked
  chosenCount = the number of @chosenLoans
  overdueLoans = the @loans whose @due is below @today, earliest @due first, ties by lowest @id
  overdueCount = the number of @overdueLoans
  onLoanCount = the number of @loans
}

screen {
  section top as header {
    heading "Neighbourhood library"
    text todayLabel = "Day {today}" as badge
    button nextDay "Next day" as secondary
  }

  section stats as grid {
    section overdueStat as StatCard {
      text overdueLabel = "Overdue loans"
      text overdueValue = @overdueCount as stat {
        look "In the danger colour when it is above 0, otherwise in the normal heading colour."
      }
    }
    section onLoanStat as StatCard {
      text onLoanLabel = "Books on loan"
      text onLoanValue = @onLoanCount as stat
    }
  }

  section desk as row {
    section catalogue as card {
      section catalogueBar as toolbar {
        text catalogueTitle = "Books" as title
        field search "Search title or author" as search
      }
      list shown of Book = @pager.visible as table {
        text title
        text author {
          look "Muted."
        }
        text availability = "{a} of {its @copies} available", where a is its @copies minus the number of @loans whose book is its @title {
          as badge
          look "Success-tinted when at least one copy is available; neutral when none are."
        }
        button lend "Lend" as secondary {
          visible when @chosen is not empty
        }
      }
      section noBooks as EmptyState {
        visible when @matching is empty
        text noBooksTitle = "No books found"
        text noBooksHint = "Try another title or author."
      }
      use pager = Pager {
        items = matching
        size = 5
        visible when @matching is not empty
      }
    }

    section memberPanel as card {
      text memberPanelTitle = "Member" as title
      select chosen from members.name as dropdown
      button clearMember "Clear" as ghost {
        visible when @chosen is not empty
      }
      section noMember as EmptyState {
        visible when @chosen is empty
        text noMemberTitle = "No member picked"
        text noMemberHint = "Pick a member to see their loans and lend books."
      }
      section memberInfo as MemberCard {
        visible when @chosen is not empty
        text memberName = the @name of @chosenMember
        text memberNumber = "Member #{number}", where @number is the @number of @chosenMember
        text memberCount = "{chosenCount} of 3 books out"
      }
      list memberLoans of Loan = @chosenLoans as table {
        visible when @chosen is not empty
        look "Rows of overdue loans (its due below today) have a light danger background."
        text book
        text loanDue = "Overdue, was due day {its @due}" when its @due is below @today, otherwise "Due day {its @due}" {
          as DueBadge
        }
        button takeBack "Take back" as secondary
      }
      text noLoans = "No books out." {
        as caption
        visible when @chosen is not empty and @chosenLoans is empty
      }
    }
  }

  section overdue as card {
    visible when @overdueLoans is not empty
    text overdueTitle = "Overdue loans" as title
    list overdueList of Loan = @overdueLoans as table {
      look "Every row has a light danger background."
      text overdueBook = its book
      text overdueWho = the @name of the member whose @number is its member
      text overdueDue = "Overdue, was due day {its @due}" as DueBadge
    }
  }

  use toast = Toast
}

on click nextDay {
  - increase @today by 1
  - set @toast.message to "It is now day {today}"
}

on type search {
  - set @pager.page to 1
}

on choose chosen {
  - set @toast.message to "Showing loans of {chosen}"
}

on click clearMember {
  - clear @chosen
  - set @toast.message to "No member picked"
}

on click lend {
  - if @chosen is empty, do nothing and stop
  - if @chosenLoans has a loan whose book is that book's @title, set @toast.message to "Cannot lend {that book's @title}: {chosen} already has it" and stop
  - if that book's @copies minus the number of @loans whose book is that book's @title is 0 or less, set @toast.message to "Cannot lend {that book's @title}: no copies left" and stop
  - if @chosenCount is 3 or more, set @toast.message to "Cannot lend {that book's @title}: {chosen} already has 3 books out" and stop
  - add a @Loan to @loans with @id @nextLoanId, book that book's @title, member the @number of @chosenMember, @lentOn @today and @due @today + 14
  - increase @nextLoanId by 1
  - set @toast.message to "Lent {that book's @title} to {chosen}, due day {@today + 14}"
}

on click takeBack {
  - remove that loan from @loans
  - set @toast.message to "{that loan's book} returned by {the @name of the member whose @number is that loan's member}"
}

rules {
  - A book never has more @loans than its @copies: the "n of m available" @number in availability never goes below 0.
  - A member never has more than 3 @loans.
  - A loan is overdue when its @due is below @today; on its @due day itself it is not yet overdue.
  - Only nextDay changes @today, always by exactly 1.
}

always {
  see shown has at most 5 rows
  see memberLoans has at most 3 rows
}

example "the first page of the catalogue" {
  see todayLabel = "Day 20"
  see overdueValue = 0
  see onLoanValue = 6
  see shown has 5 rows
  see title on row 1 = "Beloved"
  see availability on row 1 = "1 of 2 available"
  see availability on row 3 = "0 of 1 available"
  see availability on row 5 = "2 of 2 available"
  see pager.pageInfo = "Page 1 of 3"
  see pager.previous is disabled
  see lend on row 1 is hidden
  see noMemberTitle = "No member picked"
  see overdue is hidden
  snapshot "catalogue, nobody picked"
}

example "paging through twelve books" {
  click pager.next
  see title on row 1 = "Middlemarch"
  see pager.pageInfo = "Page 2 of 3"
  click pager.next
  see shown has 2 rows
  see title on row 2 = "Wuthering Heights"
  see availability on row 1 = "0 of 1 available"
  see pager.next is disabled
  click pager.previous
  see pager.pageInfo = "Page 2 of 3"
}

example "search by author" {
  type "austen" into search
  see shown has 3 rows
  see title on row 1 = "Emma"
  see author on row 1 = "Jane Austen"
  see title on row 3 = "Pride and Prejudice"
  see availability on row 3 = "3 of 3 available"
  see pager.pageInfo = "Page 1 of 1"
}

example "spaces around the search are ignored" {
  type " austen " into search
  see shown has 3 rows
}

example "search by title jumps back to page 1" {
  click pager.next
  type "Hobbit" into search
  see shown has 1 row
  see title on row 1 = "The Hobbit"
  see pager.pageInfo = "Page 1 of 1"
}

example "search with no result" {
  type "zzz" into search
  see noBooksTitle = "No books found"
  see noBooksHint = "Try another title or author."
  see shown has 0 rows
  snapshot "no books found"
}

example "picking a member shows their loans" {
  choose "Ann Jansen" in chosen
  see toast.message = "Showing loans of Ann Jansen"
  see memberName = "Ann Jansen"
  see memberNumber = "Member #101"
  see memberCount = "2 of 3 books out"
  see memberLoans has 2 rows
  see book on row 1 of memberLoans = "Dune"
  see loanDue on row 1 = "Due day 22"
  see loanDue on row 2 = "Due day 29"
  see lend on row 1 is shown
  snapshot "member picked"
}

example "clearing the member" {
  choose "Ann Jansen" in chosen
  click clearMember
  see toast.message = "No member picked"
  see noMemberTitle = "No member picked"
  see lend on row 1 is hidden
  see memberLoans is hidden
  see clearMember is hidden
}

example "already having it wins over no copies left" {
  choose "Ann Jansen" in chosen
  click lend on row with "Emma"
  see toast.message = "Cannot lend Emma: Ann Jansen already has it"
}

example "a member without loans" {
  choose "Eva Visser" in chosen
  see memberCount = "0 of 3 books out"
  see memberLoans has 0 rows
  see noLoans = "No books out."
}

example "borrowing a book" {
  choose "Carla Smit" in chosen
  click lend on row with "Jane Eyre"
  see toast.message = "Lent Jane Eyre to Carla Smit, due day 34"
  see availability on row 5 = "1 of 2 available"
  see memberCount = "2 of 3 books out"
  see memberLoans has 2 rows
  see book on row 2 of memberLoans = "Jane Eyre"
  see loanDue on row 2 = "Due day 34"
  see onLoanValue = 7
  snapshot "after lending"
}

example "no copies left" {
  choose "Eva Visser" in chosen
  click lend on row with "Emma"
  see toast.message = "Cannot lend Emma: no copies left"
  see availability on row 3 = "0 of 1 available"
  see memberLoans has 0 rows
  see onLoanValue = 6
}

example "the last copy goes, then none are left" {
  choose "Eva Visser" in chosen
  click lend on row with "Dune"
  see availability on row 2 = "0 of 2 available"
  choose "Daan Bakker" in chosen
  click lend on row with "Dune"
  see toast.message = "Cannot lend Dune: no copies left"
  see memberCount = "0 of 3 books out"
}

example "the 3-book limit" {
  choose "Ben de Vries" in chosen
  see memberCount = "3 of 3 books out"
  click lend on row with "Jane Eyre"
  see toast.message = "Cannot lend Jane Eyre: Ben de Vries already has 3 books out"
  see memberLoans has 3 rows
  see availability on row 5 = "2 of 2 available"
  see onLoanValue = 6
}

example "the same book twice is refused" {
  choose "Ann Jansen" in chosen
  click lend on row with "Dune"
  see toast.message = "Cannot lend Dune: Ann Jansen already has it"
  see memberCount = "2 of 3 books out"
}

example "returning a book makes the copy available" {
  choose "Ben de Vries" in chosen
  click takeBack on row with "Hamlet"
  see toast.message = "Hamlet returned by Ben de Vries"
  see memberCount = "2 of 3 books out"
  see availability on row 4 = "1 of 1 available"
  see onLoanValue = 5
  click lend on row with "Jane Eyre"
  see toast.message = "Lent Jane Eyre to Ben de Vries, due day 34"
  see memberCount = "3 of 3 books out"
}

example "advancing days makes loans overdue" {
  click nextDay
  see todayLabel = "Day 21"
  see toast.message = "It is now day 21"
  click nextDay
  see todayLabel = "Day 22"
  see overdueValue = 0
  see overdue is hidden
  click nextDay
  see todayLabel = "Day 23"
  see overdueValue = 1
  see overdueList has 1 row
  see overdueBook on row 1 = "Dune"
  see overdueWho on row 1 = "Ann Jansen"
  see overdueDue on row 1 = "Overdue, was due day 22"
  choose "Ann Jansen" in chosen
  see loanDue on row 1 = "Overdue, was due day 22"
  see loanDue on row 2 = "Due day 29"
  snapshot "an overdue loan"
  click nextDay
  click nextDay
  see todayLabel = "Day 25"
  see overdueValue = 2
  see overdueBook on row 2 = "Middlemarch"
  see overdueWho on row 2 = "Carla Smit"
}

example "a new loan is due 14 days after the day it was made" {
  click nextDay
  click nextDay
  choose "Daan Bakker" in chosen
  click lend on row with "Jane Eyre"
  see toast.message = "Lent Jane Eyre to Daan Bakker, due day 36"
  see loanDue on row 1 = "Due day 36"
}

example "returning an overdue book lowers the count" {
  click nextDay
  click nextDay
  click nextDay
  see overdueValue = 1
  choose "Ann Jansen" in chosen
  click takeBack on row with "Dune"
  see toast.message = "Dune returned by Ann Jansen"
  see overdueValue = 0
  see overdue is hidden
  see availability on row 2 = "2 of 2 available"
}

example "dismissing the message" {
  click nextDay
  see toast.message = "It is now day 21"
  click toast.dismiss
  see toast.message is hidden
}
