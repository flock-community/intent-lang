app DeskUi {
  "An agent's own tickets, after signing in with their API key."
  "The list follows changes made elsewhere: a ticket taken in another tab shows up here."
  "The desk tells each agent only about their own tickets; a lead hears about every ticket."
}
language v47
import support.tickets

uses support.deskApi as desk {
  tested with "apps/api/desk-api.intent"
  through std.http.sendKey {
    key = apiKey
  }
}

state {
  apiKey: Text = ""                # the key the agent signed in with
  mine: List Ticket = []           # the agent's tickets, as the desk last listed them
  problem: Text = ""
  heard: Int = 0                   # the ticket events this screen heard since signing in
}

screen {
  field apiKey "API key"
  button signIn "Show my tickets" {
    enabled when @apiKey is not blank
  }
  text problem {
    visible when problem is not empty
  }
  text updates = "Updates: {heard}"
  list mine of Ticket {
    text subject
    text status
    button solve "Solve" {
      enabled when its @status is not @Solved
    }
  }
}

on click signIn {
  - set @heard to 0
  - call @desk.myTickets
}

on answer desk.myTickets {
  if its status is 200 {
    - set @mine to its body and clear @problem
  } else if its status is 401 {
    - clear @mine and set @problem to the error in its body
  } else {
    - set @problem to "Could not load your tickets"
  }
}

on click solve {
  - call @desk.solveTicket with @id = the @id of that ticket
}

on answer desk.solveTicket {
  if its status is 200 {
    - clear @problem
  } else if its status is 401, 403, 404 or 409 {
    - set @problem to the error in its body
  } else {
    - set @problem to "Could not solve the ticket"
  }
}

on event desk.ticketSolved {
  - increase @heard by 1
  - replace the ticket in @mine with the same @id as its body by its body
}

on event desk.ticketAssigned {
  - increase @heard by 1
  - call @desk.myTickets
}

example "a wrong key" {
  type "k-bob-0000" into apiKey
  click signIn
  see problem = "Unknown API key"
  see mine has 0 rows
}

example "Sam's own tickets" {
  see signIn is disabled
  type "k-sam-91bc" into apiKey
  click signIn
  see mine has 2 rows
  see subject on row 1 = "Feature request: dark mode"
  see problem is hidden
}

example "Sam solves a ticket" {
  type "k-sam-91bc" into apiKey
  click signIn
  click solve on row with "Cannot log in after reset"
  see status on row 2 = "Solved"
  see solve on row 2 is disabled
}

example "a ticket Sam takes in another tab shows up" {
  type "k-sam-91bc" into apiKey
  click signIn
  call desk.takeTicket as "Sam" with id = 4
  see mine has 3 rows
  see subject on row 1 = "Export to CSV is empty"
}

example "a lead solves Sam's ticket elsewhere, and Sam's list follows" {
  type "k-sam-91bc" into apiKey
  click signIn
  call desk.solveTicket as "Lin" with id = 1
  see status on row 2 = "Solved"
  see solve on row 2 is disabled
  see updates = "Updates: 1"
}

example "Sam hears only about his own tickets" {
  type "k-sam-91bc" into apiKey
  click signIn
  call desk.takeTicket as "Ann" with id = 4
  see updates = "Updates: 0"
  call desk.solveTicket as "Ann" with id = 2
  see updates = "Updates: 0"
  call desk.solveTicket as "Lin" with id = 3
  see updates = "Updates: 1"
}

example "a lead hears about every ticket" {
  type "k-lin-44d0" into apiKey
  click signIn
  see mine has 0 rows
  call desk.takeTicket as "Sam" with id = 4
  see updates = "Updates: 1"
  call desk.solveTicket as "Ann" with id = 2
  see updates = "Updates: 2"
}

example "before signing in, nothing arrives" {
  call desk.takeTicket as "Ann" with id = 4
  see mine has 0 rows
  see problem is hidden
}
