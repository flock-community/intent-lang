app Board {
  "A tiny kanban board with three columns and at most three cards in progress."
}
language v44

choice Column: Todo | Doing | Done

record Card {
  title: Text
  column: Column
}

state {
  cards: List Card = []
  draft: Text = ""
}

derive {
  full = there are 3 @cards in @Doing
}

screen {
  field draft "New card"
  button add "Add" {
    enabled when @draft is not blank
  }
  heading "To do"
  list todo of Card = the @cards in @Todo {
    text title
    button start "Start" {
      enabled when not @full
    }
  }
  heading "Doing"
  list doing of Card = the @cards in @Doing {
    text title
    button back "Back"
    button finish "Finish"
  }
  heading "Done"
  list done of Card = the @cards in @Done {
    text title
    button reopen "Reopen" {
      enabled when not @full
    }
  }
  text wip = "Doing {number of @cards in @Doing}/3"
}

on click add {
  - add a card with the @draft, trimmed, as @title to @Todo
  - clear @draft
}

on click start {
  - move the card to @Doing
}

on click back {
  - move the card back to @Todo
}

on click finish {
  - move the card to @Done
}

on click reopen {
  - move the card back to @Doing
}

rules {
  - A moved card goes to the end of its new @column.
}

always {
  see doing has at most 3 rows
}

example "a card moves along" {
  type " Write report " into draft
  click add
  see draft = ""
  see todo has 1 row
  see title on row 1 of todo = "Write report"
  see wip = "Doing 0/3"
  click start on row 1
  see doing has 1 row
  see wip = "Doing 1/3"
  click finish on row 1
  see title on row 1 of done = "Write report"
}

example "blank cards cannot be added" {
  see add is disabled
  type "  " into draft
  see add is disabled
}

example "the limit" {
  type "A" into draft
  click add
  type "B" into draft
  click add
  type "C" into draft
  click add
  type "D" into draft
  click add
  click start on row with "A"
  click start on row with "B"
  click start on row with "C"
  see wip = "Doing 3/3"
  see start on row with "D" is disabled
  click finish on row with "A"
  see start on row with "D" is enabled
  click start on row with "D"
  see reopen on row with "A" is disabled
}

example "moved cards go to the end" {
  type "A" into draft
  click add
  type "B" into draft
  click add
  click start on row with "A"
  click start on row with "B"
  click back on row with "A"
  see todo has 1 row
  type "C" into draft
  click add
  see title on row 1 of todo = "A"
  see title on row 2 of todo = "C"
  click back on row with "B"
  see title on row 3 of todo = "B"
}
