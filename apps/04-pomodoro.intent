app Pomodoro {
  "A focus timer: 25 minutes of work, then a 5 minute break; every fourth break is a long one of 15 minutes."
}

choice Phase: Work | ShortBreak | LongBreak

state {
  phase: Phase = Work
  remaining: Int = 1500    # seconds left in this phase
  running: Bool = false
  completed: Int = 0       # work phases finished
}

clock every 1s

screen {
  text phaseName = Work shows "Focus", ShortBreak "Short break", LongBreak "Long break"
  text time = "{remaining as clock}"
  button startStop = "Pause" while running, otherwise "Start"
  button skip "Skip"
  button reset "Reset"
  text done = "{completed} done"
}

on click startStop {
  - flip running
}

on tick {
  - if not running, do nothing
  - decrease remaining by 1
  - if remaining is now 0, move to the next phase; running stays true
}

on click skip {
  - move to the next phase; running does not change
}

on click reset {
  - go back to the initial state: Work, 1500, not running, completed 0
}

rules {
  - Moving to the next phase: after Work, completed increases by 1, and the next phase is LongBreak (900 seconds) when completed is now a multiple of 4, otherwise ShortBreak (300 seconds). After ShortBreak or LongBreak the next phase is Work (1500 seconds).
}

example "initial screen" {
  see phaseName = "Focus"
  see time = "25:00"
  see startStop = "Start"
  see done = "0 done"
}

example "counting down" {
  click startStop
  see startStop = "Pause"
  wait 3s
  see time = "24:57"
  click startStop
  wait 10s
  see time = "24:57"
  see startStop = "Start"
}

example "work ends in a short break" {
  click startStop
  wait 1500s
  see phaseName = "Short break"
  see time = "5:00"
  see done = "1 done"
  see startStop = "Pause"
  wait 300s
  see phaseName = "Focus"
  see time = "25:00"
}

example "every fourth break is long" {
  click skip
  click skip
  click skip
  click skip
  click skip
  click skip
  see phaseName = "Focus"
  see done = "3 done"
  click skip
  see phaseName = "Long break"
  see time = "15:00"
  see done = "4 done"
}

example "reset" {
  click startStop
  wait 5s
  click skip
  click reset
  see phaseName = "Focus"
  see time = "25:00"
  see startStop = "Start"
  see done = "0 done"
}
