app Calculator {
  "A pocket calculator that works like the cheap ones: operations happen in the order they are typed, without precedence."
}
language v47
record Key {
  label: Text
}

choice Op: Plus | Minus | Times | Divide

state {
  keys: List Key = table {
    label
    "7"
    "8"
    "9"
    "÷"
    "4"
    "5"
    "6"
    "×"
    "1"
    "2"
    "3"
    "−"
    "0"
    "."
    "="
    "+"
  }
  display: Text = "0"
  acc: Decimal = 0          # the running result
  pending: Op or nothing = nothing
  typing: Bool = false      # true while the user is typing a number
  failed: Bool = false
}

screen {
  text display
  list keys of Key {
    button press = @label
  }
  button clear "C"
}

on click press {
  if @failed {
    stop
  }
  - a digit: if @typing, append it to @display (but a @display of "0" is replaced by the digit, and at most 12 digits are kept: more are ignored); if not @typing, @display becomes the digit and @typing becomes true
  - ".": if @typing and @display has no ".", append it; if @typing and @display has a ".", ignore it; if not @typing, @display becomes "0." and @typing becomes true
  - an operator (÷ × − +): if @pending is set and @typing, first compute @acc <@pending> @display and show the result; if @pending is not set, @acc becomes the number on @display; then @pending becomes this operator and @typing becomes false (so pressing two operators in a row just replaces @pending)
  - "=": if @pending is set, compute @acc <@pending> @display, show the result, and set @pending to nothing and @typing to false; otherwise do nothing
}

on click clear {
  - go back to the initial state
}

rules {
  - Computing a result: dividing by 0 sets @failed and shows "Error"; so does a result whose size is 1000000000000 or more. Otherwise @acc becomes the result and @display shows it with Fmt.decimal 8.
  - When @typing, @display shows exactly the typed characters.
  - The number on @display is what it shows, with a "." at the end ignored: "870." is 870.
}

example "no precedence" {
  click press on row with "2"
  click press on row with "+"
  click press on row with "3"
  click press on row with "×"
  see display = "5"
  click press on row with "4"
  click press on row with "="
  see display = "20"
}

example "decimals" {
  click press on row with "1"
  click press on row with "÷"
  click press on row with "3"
  click press on row with "="
  see display = "0.33333333"
  click press on row with "."
  click press on row with "1"
  click press on row with "+"
  click press on row with "."
  click press on row with "2"
  click press on row with "="
  see display = "0.3"
}

example "typing numbers" {
  see display = "0"
  click press on row with "0"
  see display = "0"
  click press on row with "1"
  click press on row with "2"
  click press on row with "."
  click press on row with "5"
  click press on row with "."
  click press on row with "3"
  see display = "12.53"
}

example "operators in a row" {
  click press on row with "2"
  click press on row with "×"
  click press on row with "−"
  click press on row with "3"
  click press on row with "="
  see display = "-1"
}

example "going on after equals" {
  click press on row with "2"
  click press on row with "+"
  click press on row with "3"
  click press on row with "="
  click press on row with "×"
  click press on row with "4"
  click press on row with "="
  see display = "20"
  click press on row with "="
  see display = "20"
  click press on row with "7"
  see display = "7"
}

example "division by zero" {
  click press on row with "5"
  click press on row with "÷"
  click press on row with "0"
  click press on row with "="
  see display = "Error"
  click press on row with "3"
  see display = "Error"
  click clear
  see display = "0"
  see press on row 16 = "+"
}

example "twelve digits at most" {
  click press on row with "9"
  click press on row with "9"
  click press on row with "9"
  click press on row with "9"
  click press on row with "9"
  click press on row with "9"
  click press on row with "9"
  click press on row with "9"
  click press on row with "9"
  click press on row with "9"
  click press on row with "9"
  click press on row with "9"
  click press on row with "9"
  see display = "999999999999"
  click press on row with "+"
  click press on row with "1"
  click press on row with "="
  see display = "Error"
}

example "a point at the end counts as nothing" {
  click press on row with "8"
  click press on row with "."
  click press on row with "−"
  click press on row with "3"
  click press on row with "="
  see display = "5"
}
