app PayoutsApi {
  "Clerks request payouts to suppliers. A small payout is paid at once; a larger one waits until an approver who did not request it approves it."
  "A clerk is never also an approver (separation of duty), and a role that is granted or revoked counts from the next request on."
}

language 1

profile api

layer secure = std.http.secure
layer auth = std.http.apiKey {
  keys = table {
    secret        | owner
    "k-cy-4f1a"   | "Cy"
    "k-dee-8b2c"  | "Dee"
    "k-ava-3e9d"  | "Ava"
    "k-lu-5c7e"   | "Lu"
    "k-root-0d6f" | "Root"
  }
}

choice Role: Clerk | Approver | Lead | Admin
choice PayoutStatus: Requested | Paid

record Grant {
  who: Text
  role: Role
}

record Payout {
  id: Int
  payee: Text
  amount: Int                        # in cents
  requester: Text
  approver: Text or nothing          # nothing for a payout paid at once, and while it waits
  status: PayoutStatus
}

state {
  stored grants: List Grant = table {
    who    | role
    "Cy"   | Clerk
    "Dee"  | Clerk
    "Ava"  | Approver
    "Lu"   | Lead
    "Root" | Admin
  }
  stored payouts: List Payout = []
  stored approvalLimit: Int = 50000  # up to 500.00 a payout is paid at once
}

derive {
  nextId: Int = the highest @id in @payouts + 1, or 1 when there is none
}

access {
  roles = grants
  - a @Clerk or a @Lead may call @requestPayout when @amount is at most 1000000: "A payout above 10000.00 is not requested here"
  - a @Clerk, an @Approver or a @Lead may call @listPayouts
  - an @Approver or a @Lead may call @approvePayout
  - no one may call @approvePayout when that payout's @requester is the @caller: "A second person must approve"
  - no one may call @approvePayout when that payout's @status is not @Requested: "This payout is not waiting for approval"
  - an @Admin may call @grantRole and @revokeRole
}

endpoint requestPayout POST "/payouts" {
  body payee: Text
  body amount: Int
  answers 201 Payout
  answers 400 Problem
  answers 401 Problem
  answers 403 Problem
  if @payee, trimmed, is blank {
    answer 400 "Payee is required"
  }
  if @amount is below 1 {
    answer 400 "Amount must be at least 1 cent"
  }
  - add a @Payout to the end of @payouts with @id = @nextId, @payee = @payee trimmed, the given @amount, @requester = the @caller, @approver = nothing and @status @Requested
  if @amount is at most @approvalLimit {
    - set the new payout's @status to @Paid       # a small payout needs no second person
  }
  answer 201 with the new payout
}

endpoint listPayouts GET "/payouts" {
  answers 200 List Payout
  answers 401 Problem
  answers 403 Problem
  answer 200 with the @payouts sorted by @id, highest first
}

endpoint approvePayout POST "/payouts/{id}/approve" {
  path id: ref Payout
  answers 200 Payout
  answers 401 Problem
  answers 403 Problem
  answers 404 Problem
  if that payout does not exist {
    answer 404 "No such payout"
  }
  - set its @status to @Paid
  - set its @approver to the @caller
  answer 200 with the payout
}

endpoint grantRole POST "/grants" {
  body person: Text
  body role: Role
  answers 201 Grant
  answers 401 Problem
  answers 403 Problem
  answers 409 Problem
  if there is a grant in @grants whose @who is @person and whose @role is @role {
    answer 409 "Already granted"
  }
  if @role is @Approver and there is a grant in @grants whose @who is @person and whose @role is @Clerk {
    answer 409 "A clerk cannot also approve"
  }
  if @role is @Clerk and there is a grant in @grants whose @who is @person and whose @role is @Approver {
    answer 409 "An approver cannot also be a clerk"
  }
  - add a @Grant to the end of @grants with @who = @person and @role = @role
  answer 201 with the new grant
}

endpoint revokeRole POST "/grants/revoke" {
  body person: Text
  body role: Role
  if there is no grant in @grants whose @who is @person and whose @role is @role {
    answer 404 "No such grant"
  }
  - remove every grant from @grants whose @who is @person and whose @role is @role
  answer 204
}

always {
  - no @Payout in @payouts whose @amount is above @approvalLimit is @Paid while its @approver is nothing
  - every @Payout in @payouts whose @approver is not nothing has an @approver that is not its @requester
  - no two @grants have the same @who with one @Clerk and the other @Approver
}

example "a small payout is paid at once" {
  call requestPayout as "Cy" with payee = " Acme ", amount = 20000
  see requestPayout.status = 201
  see requestPayout.body.payee = "Acme"
  see requestPayout.body.status = "Paid"
  see requestPayout.body.requester = "Cy"
}

example "a larger payout waits for a second person" {
  call requestPayout as "Cy" with payee = "Globex", amount = 90000
  see requestPayout.body.status = "Requested"
  call approvePayout as "Dee" with id = 1
  see approvePayout.status = 403
  see approvePayout.body.error = "Not allowed"
  call approvePayout as "Ava" with id = 1
  see approvePayout.status = 200
  see approvePayout.body.status = "Paid"
  see approvePayout.body.approver = "Ava"
  call approvePayout as "Ava" with id = 1
  see approvePayout.status = 403
  see approvePayout.body.error = "This payout is not waiting for approval"
}

example "a lead may request and approve, never their own" {
  call requestPayout as "Lu" with payee = "Initech", amount = 70000
  call approvePayout as "Lu" with id = 1
  see approvePayout.status = 403
  see approvePayout.body.error = "A second person must approve"
  call requestPayout as "Cy" with payee = "Hooli", amount = 80000
  call approvePayout as "Lu" with id = 2
  see approvePayout.status = 200
  see approvePayout.body.approver = "Lu"
  see audit[2].rules = "[\"apps/api/payouts-api.intent:61\"]"
}

example "above the limit a payout is not requested here" {
  call requestPayout as "Cy" with payee = "Umbrella", amount = 2000000
  see requestPayout.status = 403
  see requestPayout.body.error = "A payout above 10000.00 is not requested here"
  call requestPayout as "Cy" with payee = "Umbrella", amount = 1000000
  see requestPayout.status = 201
  call listPayouts as "Ava"
  see listPayouts.body has 1 rows
  call listPayouts as "Root"
  see listPayouts.status = 403
}

example "a role counts from the next request on" {
  call revokeRole as "Root" with person = "Dee", role = Clerk
  see revokeRole.status = 204
  call requestPayout as "Dee" with payee = "Acme", amount = 100
  see requestPayout.status = 403
  call grantRole as "Root" with person = "Dee", role = Clerk
  see grantRole.status = 201
  call requestPayout as "Dee" with payee = "Acme", amount = 100
  see requestPayout.status = 201
  call grantRole as "Cy" with person = "Cy", role = Approver
  see grantRole.status = 403
}

example "a clerk is never an approver" {
  call grantRole as "Root" with person = "Cy", role = Approver
  see grantRole.status = 409
  see grantRole.body.error = "A clerk cannot also approve"
  call grantRole as "Root" with person = "Ava", role = Clerk
  see grantRole.status = 409
  see grantRole.body.error = "An approver cannot also be a clerk"
  call grantRole as "Root" with person = "Cy", role = Clerk
  see grantRole.status = 409
  see grantRole.body.error = "Already granted"
  call revokeRole as "Root" with person = "Cy", role = Approver
  see revokeRole.status = 404
}

example "what a payout needs, and who may ask" {
  call requestPayout as "Cy" with payee = "  ", amount = 100
  see requestPayout.status = 400
  see requestPayout.body.error = "Payee is required"
  call requestPayout as "Cy" with payee = "Acme", amount = 0
  see requestPayout.status = 400
  call requestPayout with payee = "Acme", amount = 100
  see requestPayout.status = 401
  call approvePayout as "Ava" with id = 7
  see approvePayout.status = 404
}
