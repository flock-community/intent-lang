app NoticesApi {
  "Short notices for a team: each one disappears when its time is up, and nobody posts more than three an hour."
}

profile api

examples start at 2026-09-24 09:00

record Notice {
  id: Int
  text: Text
  sender: Text
  sentAt: DateTime
  expiresAt: DateTime
}

state {
  notices: List Notice = []
}

event noticeExpired: Notice          # a notice's time was up, and it was removed

endpoint post POST "/notices" {
  body text: Text
  body sender: Text
  body duration: Int                 # how many minutes the notice stays
  returns Notice
  if @text, trimmed, is blank {
    answer 400 "Text is required"
  }
  if @duration is below 1 or above 1440 {
    answer 400 "Duration must be between 1 and 1440 minutes"
  }
  if 3 or more of the @notices have this @sender and a @sentAt less than 60 minutes before @now {
    answer 429 "At most 3 notices an hour"
  }
  - add a @Notice to the end of @notices with @id = the highest @id in @notices + 1 (1 when there are none), @text trimmed, the given @sender, @sentAt = @now and @expiresAt = @duration minutes after @now
  answer 201 with the new notice
}

endpoint list GET "/notices" {
  returns List Notice
  answer 200 with the @notices, the latest @sentAt first, and on the same @sentAt the highest @id first
}

every 1m {
  - every notice whose @expiresAt is at or before @now is removed from @notices, in the order of @notices, and for each one publish @noticeExpired with that notice
}

example "a notice lives for its minutes" {
  call post with text = " Lunch at noon ", sender = "Ann", duration = 30
  see post.status = 201
  see post.body.text = "Lunch at noon"
  see post.body.sentAt = 2026-09-24 09:00
  see post.body.expiresAt = 2026-09-24 09:30
  wait 29m
  call list
  see list.body has 1 row
  wait 1m
  see noticeExpired.body.text = "Lunch at noon"
  call list
  see list.body has 0 rows
}

example "newest first" {
  call post with text = "One", sender = "Ann", duration = 60
  wait 5m
  call post with text = "Two", sender = "Bob", duration = 60
  call list
  see list.body[1].text = "Two"
  see list.body[2].text = "One"
}

example "at most three an hour per sender" {
  call post with text = "1", sender = "Ann", duration = 600
  call post with text = "2", sender = "Ann", duration = 600
  wait 30m
  call post with text = "3", sender = "Ann", duration = 600
  call post with text = "4", sender = "Ann", duration = 600
  see post.status = 429
  see post.body.error = "At most 3 notices an hour"
  call post with text = "B", sender = "Bob", duration = 600
  see post.status = 201
  wait 30m
  call post with text = "5", sender = "Ann", duration = 600
  see post.status = 201
}

example "bad input" {
  call post with text = "  ", sender = "Ann", duration = 10
  see post.status = 400
  see post.body.error = "Text is required"
  call post with text = "Hi", sender = "Ann", duration = 0
  see post.status = 400
  see post.body.error = "Duration must be between 1 and 1440 minutes"
  call post with text = "Hi", sender = "Ann", duration = "soon"
  see post.status = 400
  see post.body.error = "duration must be a whole number"
}
