app DeskApi {
  "The support desk's API for agents, called from the desk's web pages."
  "Every request carries an agent's API key; what an agent may do depends on who they are: an agent works on their own tickets, a lead on every ticket."
}
language 1

import support.tickets

implements support.deskApi

# The first layer sees every request first and every answer last.
layer secure = std.http.secure
layer cors = std.http.cors {
  origins = "https://desk.example"
  headers = "content-type", "x-api-key"
}
layer auth = std.http.apiKey {
  keys = table {
    secret         | owner
    "k-ann-7f3a"   | "Ann"
    "k-sam-91bc"   | "Sam"
    "k-lin-44d0"   | "Lin"
    "k-eve-0b1e"   | "Eve"
  }
}

choice Role: Agent | Lead

record Grant {
  who: Text                             # a caller, as the key layer names them
  role: Role
}

state {
  stored grants: List Grant = table {
    who   | role
    "Ann" | Agent
    "Sam" | Agent
    "Lin" | Lead
  }
  tickets: List Ticket = table {
    id | subject                        | customer        | priority | status  | assignee
    1  | "Cannot log in after reset"    | "Mara Jansen"   | Urgent   | Open    | "Sam"
    2  | "Invoice shows wrong VAT"      | "Piet de Vries" | High     | Open    | "Ann"
    3  | "Feature request: dark mode"   | "Lena Smit"     | Low      | Pending | "Sam"
    4  | "Export to CSV is empty"       | "Tom Mulder"    | High     | Open    | nothing
    5  | "Refund for double charge"     | "Noah Peters"   | Urgent   | Solved  | "Ann"
  }
  comments: List Comment = []
}

access {
  roles = grants
  - anyone, without a key, may call @health
  - an @Agent may call @myTickets, @takeTicket and @addComment
  - an @Agent may call @solveTicket when that ticket's @assignee is the @caller: "Only the assignee can solve this ticket"
  - a @Lead may call every endpoint
  - an @Agent may hear @ticketAssigned and @ticketSolved when its body's @assignee is the @caller
  - a @Lead may hear every event
}

endpoint health {
  answer 200 with a @Health whose @status is "ok"
}

endpoint myTickets {
  answer 200 with the @tickets whose @assignee is the @caller sorted by @id, highest first
}

endpoint takeTicket {
  if that ticket does not exist {
    answer 404 "No such ticket"
  }
  if there is a @assignee on that ticket and it is not the @caller {
    answer 409 "Already taken by {that ticket's @assignee, or "someone" when there is none}"
  }
  - set its @assignee to the @caller
  - publish @ticketAssigned with the ticket
  answer 200 with the ticket
}

endpoint solveTicket {
  if that ticket does not exist {
    answer 404 "No such ticket"
  }
  if that ticket is @Solved {
    answer 409 "Already solved"
  }
  - set its @status to @Solved
  - publish @ticketSolved with the ticket
  answer 200 with the ticket
}

endpoint addComment {
  if that ticket does not exist {
    answer 404 "No such ticket"
  }
  if @text, trimmed, is blank {
    answer 400 "Comment is empty"
  }
  - add a @Comment to the end of @comments with @ticket = @id, @author = the @caller and @body = @text trimmed
  answer 201 with the new comment
}

always {
  see myTickets.status is below 500
}

example "anyone may ask whether the desk is up; every answer has the safe headers" {
  call health
  see health.status = 200
  see health.body.status = "ok"
  see health.header.x-content-type-options = "nosniff"
  see health.header.cache-control = "no-store"
}

example "without a key nothing else answers, and the refusal is safe too" {
  call myTickets
  see myTickets.status = 401
  see myTickets.body.error = "Missing API key"
  see myTickets.header.x-frame-options = "DENY"
  call takeTicket with header x-api-key = "k-bob-0000", id = 4
  see takeTicket.status = 401
  see takeTicket.body.error = "Unknown API key"
}

example "each agent sees their own tickets" {
  call myTickets as "Ann"
  see myTickets.status = 200
  see myTickets.body has 2 rows
  see myTickets.body[1].id = 5
  call myTickets as "Sam"
  see myTickets.body has 2 rows
  see myTickets.body[1].subject = "Feature request: dark mode"
}

example "taking and solving: only the assignee solves; a lead solves any ticket" {
  call takeTicket as "Sam" with id = 4
  see takeTicket.status = 200
  see takeTicket.body.assignee = "Sam"
  see ticketAssigned.body.id = 4
  call solveTicket as "Ann" with id = 4
  see solveTicket.status = 403
  see solveTicket.body.error = "Only the assignee can solve this ticket"
  see audit[1].caller = "Sam"
  see audit[1].decision = "allowed"
  see audit[2].caller = "Ann"
  see audit[2].decision = "refused"
  see audit[2].status = 403
  call takeTicket as "Ann" with id = 1
  see takeTicket.status = 409
  see takeTicket.body.error = "Already taken by Sam"
  call solveTicket as "Sam" with id = 4
  see solveTicket.status = 200
  see solveTicket.body.status = "Solved"
  call solveTicket as "Sam" with id = 4
  see solveTicket.status = 409
  call myTickets as "Sam"
  see myTickets.body has 3 rows
  call solveTicket as "Lin" with id = 2
  see solveTicket.status = 200
  see solveTicket.body.assignee = "Ann"
}

example "an unassigned ticket is nobody's to solve but a lead's" {
  call solveTicket as "Sam" with id = 4
  see solveTicket.status = 403
  see solveTicket.body.error = "Only the assignee can solve this ticket"
  call solveTicket as "Lin" with id = 4
  see solveTicket.status = 200
}

example "a key without a role reaches nothing but health" {
  call myTickets as "Eve"
  see myTickets.status = 403
  see myTickets.body.error = "Not allowed"
  see audit[1].caller = "Eve"
  see audit[1].decision = "refused"
  call takeTicket as "Eve" with id = 4
  see takeTicket.status = 403
  see audit has 2 rows
  call health
  see health.status = 200
  call health as "Eve"
  see health.status = 200
}

example "a refusal changes nothing" {
  call addComment as "Eve" with id = 1, text = "Let me in"
  see addComment.status = 403
  call takeTicket as "Eve" with id = 4
  see takeTicket.status = 403
  see ticketAssigned is absent
  call takeTicket as "Ann" with id = 4
  see takeTicket.status = 200
  see takeTicket.body.assignee = "Ann"
}

example "a comment is by whoever calls" {
  call addComment as "Ann" with id = 1, text = "  I can take this one. "
  see addComment.status = 201
  see addComment.body.author = "Ann"
  see addComment.body.body = "I can take this one."
  call addComment as "Ann" with id = 1, text = " "
  see addComment.status = 400
  call addComment as "Ann" with id = 99, text = "Hello"
  see addComment.status = 404
}

example "the desk's web pages may call; other pages may not read the answers" {
  request OPTIONS "/tickets/mine" with header origin = "https://desk.example", header access-control-request-method = "GET"
  see request.status = 204
  see request.header.access-control-allow-headers = "content-type, x-api-key"
  call myTickets with header origin = "https://desk.example", header x-api-key = "k-ann-7f3a"
  see myTickets.header.access-control-allow-origin = "https://desk.example"
  call myTickets with header origin = "https://desk.example", header x-api-key = "wrong"
  see myTickets.status = 401
  see myTickets.header.access-control-allow-origin = "https://desk.example"
  call myTickets with header origin = "https://evil.example", header x-api-key = "k-ann-7f3a"
  see myTickets.status = 200
  see myTickets.header.access-control-allow-origin is absent
}

example "no such ticket to take or solve" {
  call takeTicket as "Sam" with id = 99
  see takeTicket.status = 404
  see takeTicket.body.error = "No such ticket"
  call solveTicket as "Sam" with id = 99
  see solveTicket.status = 404
  see solveTicket.body.error = "No such ticket"
}
