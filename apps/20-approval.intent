app Approval {
  "A payment that only goes out once a person allows it: without a standing permission the call is refused, and an Allow button lets it through; a Stop button blocks every external call."
}

import pay.payments

uses pay.paymentsApi as pay {
  tested with "apps/api/payments-api.intent"
  through std.actions {
    agree = allowed
    stop = stopped
  }
}

state {
  allowed: List Text = []             # the endpoints that may reach outside
  stopped: Bool = false
  message: Text = ""
}

screen {
  text pass = "Yoga, 10 classes: € 125.00"
  button buy "Pay"
  button allow "Allow this payment"
  button stop "Stop everything"
  text message {
    visible when @message is not empty
  }
}

on click buy {
  - call @pay.charge with @amount = 12500 and @description = "Yoga, 10 classes"
}

on click allow {
  - add "pay.charge" to the end of @allowed
}

on click stop {
  - set @stopped to true
}

on answer pay.charge {
  if its status is 201 {
    - set @message to "Paid: charge {the @id in its body}"
  } else if its status is unknown {
    - set @message to "We could not confirm the payment yet."
  } else {
    - set @message to "Payment failed: {the error}"
  }
}

example "no permission yet" {
  click buy
  see message = "Payment failed: no standing permission covers pay.charge"
}

example "allowed once" {
  click allow
  click buy
  see message = "Paid: charge 1"
}

example "the emergency stop" {
  click stop
  click buy
  see message = "Payment failed: external calls are stopped (the emergency stop is on)"
}
