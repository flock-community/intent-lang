app Approval {
  "A payment that goes out only after a person allows it: without a permission the call waits, a one-time permission lets one payment through, Reject drops it, and Stop blocks every external call."
}

import pay.payments

uses pay.paymentsApi as pay {
  tested with "apps/api/payments-api.intent"
  through std.actions {
    agree = permissions
    rejected = rejected
    stop = stopped
  }
}

state {
  permissions: List Permission = []
  rejected: List Text = []
  stopped: Bool = false
  waiting: Bool = false
  message: Text = ""
}

screen {
  text pass = "Yoga, 10 classes: € 125.00"
  button buy "Pay" {
    enabled when not @waiting
  }
  button allow "Approve" {
    enabled when @waiting
  }
  button reject "Reject" {
    enabled when @waiting
  }
  button stop "Stop everything"
  text message {
    visible when @message is not empty
  }
}

on click buy {
  - set @waiting to true
  - set @message to "Waiting for approval"
  - call @pay.charge with @amount = 12500 and @description = "Yoga, 10 classes"
}

on click allow {
  - set @waiting to false
  - add a @Permission to the end of @permissions with @endpoint = "pay.charge", @count = 1, @per = 0 and @upTo = 12500
}

on click reject {
  - set @waiting to false
  - set @message to "Payment rejected"
  - add "pay.charge" to the end of @rejected
}

on click stop {
  - set @stopped to true
}

on answer pay.charge {
  - set @waiting to false
  if its status is 201 {
    - set @message to "Paid: charge {the @id in its body}"
  } else if its status is unknown {
    - set @message to "We could not confirm the payment yet."
  } else {
    - set @message to "Payment failed: {the error}"
  }
}

example "held, then approved" {
  click buy
  see message = "Waiting for approval"
  see buy is disabled
  see allow is enabled
  click allow
  see message = "Paid: charge 1"
  see buy is enabled
  see allow is disabled
}

example "one permission, one payment" {
  click buy
  click allow
  see message = "Paid: charge 1"
  click buy
  see message = "Waiting for approval"
}

example "held, then rejected" {
  click buy
  see message = "Waiting for approval"
  see reject is enabled
  click reject
  see message = "Payment rejected"
  see buy is enabled
  see reject is disabled
}

example "the emergency stop" {
  click stop
  click buy
  see message = "Payment failed: external calls are stopped (the emergency stop is on)"
}
