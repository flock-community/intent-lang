app FixMe {
  "A spec with mechanical problems: an old Maybe type, an unmarked name and a lookup spelled with where."
}

record Item {
  id: Int
}

state {
  count: Int = 0
  maybe: Maybe Item = nothing
  items: List Item = []
}

derive {
  first = the item where @id is 1, or nothing when there is none
}

screen {
  text count
  button up "+"
}

on click up {
  - increase count by 1
}
