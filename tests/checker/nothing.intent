app NothingChecks {
  "A value that may be absent is handled where it is used."
}

record Book {
  id: Int
  rating: Int or nothing
}

state {
  picked: Int or nothing = nothing
  items: List Int = []
  total: Int = 0
  books: List Book = []
}

derive {
  shown = the item equal to @picked                    # expect: UNGUARDED
  safe = the item equal to @picked, or 0 when there is no @picked
  rated = the @rating of the book whose @id is 1       # expect: UNGUARDED
  ratedSafe = the @rating of the book whose @id is 1, or 0 when there is none
  lookedUp = the @rating of the book whose @id is 2    # expect: UNGUARDED
  lookedUpSafe = the @rating of the book whose @id is 2, or 0 when there is none
}

screen {
  text total
  button add "Add"
  button pick "Pick"
}

on click pick {
  - set @picked to 2
}

on click add {
  - increase @total by @picked                         # expect: UNGUARDED
  if there is a @picked {
    - increase @total by @picked
  }
  if there is no @picked {
    stop
  }
  - increase @total by @picked
}

example "adds" {
  click pick
  click add
  see total = "4"
}
