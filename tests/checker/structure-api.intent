app StructureApi {
  "An endpoint must answer on every path."
}

profile api

state {
  count: Int = 0
}

endpoint bump POST "/bump" {               # expect: NO_ANSWER
  returns Int
  if @count is above 10 {
    answer 409 "Too many"
  }
  - increase @count by 1
}

endpoint read GET "/count" {
  returns Int
  else {                                   # expect: SYNTAX
    answer 200 with @count
  }
  answer 200 with @count
}

endpoint stopInstead PATCH "/stop" {
  returns Int
  if @count is above 5 {
    stop                                   # expect: STEP
  }
  answer 200 with @count
}

endpoint silent PUT "/silent" {
  returns Int
  if @count is above 1 {
    answer 409                             # expect: STEP
  }
  answer 200 with @count
}

endpoint item GET "/items/{id}" {
  path id: Int
  returns Int
  if @path.id is above 0 {
    answer 200 with @path.id
  }
  answer 200 with @path.nope               # expect: UNKNOWN_NAME
}

example "bump" {
  call bump
  call read
  see read.status = 200
}
