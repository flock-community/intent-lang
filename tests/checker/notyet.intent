app NotYet {
  "Constructs the language does not have yet are NOT_YET; wire names for a choice are all or none, and each is used once."
}

choice Level: Info = "info" | Urgent = "urgent"                  # expect-not: SYNTAX  # expect-not: DUPLICATE
choice Half: Low = "low" | High                                  # expect: SYNTAX
choice Clash: One = "x" | Two = "x"                              # expect: DUPLICATE
choice Stacked {
  Up = "up"
  Down = "up"                                                    # expect: DUPLICATE
}

component Counter {                                              # expect: UNUSED
  state {
    value: Int = 0
  }
  screen {
    text shown = "{@value}"
  }
  example "counts" {                                             # expect: NOT_YET
    see shown = "0"
  }
}

record Habit {
  id: Int
  name: Text
}

record Day {
  habit: Int
  day: Int
}

state {
  habits: List Habit = table {
    id | name
    1  | "Walk"
    2  | [1, 2]                                                  # expect: NOT_YET
  }
  days: List Day = []
}

screen {
  list habits of Habit {
    text name
    list days of Day {                                           # expect: NOT_YET
      text day
    }
  }
  list days of Day {                                             # expect-not: NOT_YET
    text day
  }
}

example "walks" {
  see name on row 1 = "Walk"
  see days has 0 rows
}
