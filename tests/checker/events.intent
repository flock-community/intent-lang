app EventChecks
profile api

state {
  count: Int = 0
}

record Thing {
  id: Int
}

event counted: Int
event counted: Int                        # expect: DUPLICATE
event thing: Thing

endpoint bump POST "/bump" {
  returns Int
  - increase @count by 1
  - publish @bumped with @count           # expect: UNKNOWN_NAME
  - answer 200 with count
}

example "bump" {
  call bump
  see counted.body = 1
  see counted.status = 200                # expect: UNKNOWN_NAME
  see thing.body.id = 1
  see thing.body.nope = 1                 # expect: UNKNOWN_NAME
  see thing.body.id = "one"               # expect: STEP
}
