app InstantOwn {
  "A spec of language 1 whose own record is called Instant keeps it: the 1.1 type is a word read in its place."
}
language 1

record Instant {
  label: Text
}

state {
  moments: List Instant = []          # expect-not: NEEDS_LANGUAGE
  count: Int = 0
}

screen {
  text shown = "{@count}"
}

example "nothing yet" {
  see shown = "0"
}
